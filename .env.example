# HujiMap 환경변수 템플릿
# 주의: 실제 값은 .env.local에 설정하고 git에 커밋하지 마세요.
# Cloud Run 배포 시:
# - NEXT_PUBLIC_* 변수는 빌드 시점(Cloud Build / Docker build-arg)에 번들에 포함됩니다.
# - 서버 전용 비밀키(SUPABASE_SECRET_KEY, TOSS_TEST_SECRET_KEY, PIN_ENCRYPTION_KEY_BASE64)는
#   GCP Secret Manager에 등록하고 Cloud Run 런타임에 주입하세요.

# 앱 URL (로컬 개발: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 서버 런타임 외부 앱 URL (Cloud Run 최초 배포 후 확정된 HTTPS 서비스 URL 권장, 빌드 재실행 없이 변경 가능)
APP_URL=
# 선택: 인증 리다이렉트에 허용할 호스트 목록 (쉼표 구분, 예: hujimap-xxx-du.a.run.app,staging.hujimap.kr)
ALLOWED_APP_HOSTS=

# Supabase 공개 설정 (클라이언트·서버 공용)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase API 키: 기존 anon/service_role 또는 최신 publishable/secret 체계 지원
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase 서버 전용 비밀키 (Secret Manager 권장, 브라우저 노출 절대 금지)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Kakao Maps JavaScript SDK 공개 키 (도메인 화이트리스트 필수 등록)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
# Kakao Local REST API 키 (선택: 대량 공공데이터 지오코딩 CLI 실행 시 권장)
KAKAO_REST_API_KEY=

# OpenCage Geocoding API 키 (선택: 주소 100건 무료 시험 비교 검증용, 시험 전용 / 실서비스 유료 전환 필요)
OPENCAGE_API_KEY=

# Toss Payments 설정 (AGENTS.md Rule 4: disabled 또는 test 만 허용, live 절대 금지)
PAYMENT_MODE=disabled
NEXT_PUBLIC_TOSS_TEST_CLIENT_KEY=
# Toss 테스트 시크릿 키 (Secret Manager 권장, test_ 로 시작해야 함)
TOSS_TEST_SECRET_KEY=

# 도어락 PIN AES-256-GCM 서버 전용 암호화 키 (Secret Manager 권장, 32바이트 Base64)
PIN_ENCRYPTION_KEY_BASE64=

# 분석 기능 플래그
NEXT_PUBLIC_ANALYTICS_ENABLED=false

